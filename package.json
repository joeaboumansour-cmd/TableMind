{
  "name": "goldensquirrel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --webpack",
    "build": "next build --webpack && npm run verify:sw && npm run verify:budgets",
    "verify:sw": "node scripts/verify-sw.mjs",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:legacy": "cross-env NEXT_PUBLIC_BUILD_VARIANT=legacy BROWSERSLIST=\"chrome 109, edge 109\" next build --webpack && npm run verify:sw && npm run verify:budgets && npm run verify:legacy-css",
    "verify:legacy-css": "node scripts/verify-legacy-css.mjs",
    "baseline": "node scripts/measure-baseline.mjs",
    "harness:guard": "node harness/guard/assert-not-production.mjs",
    "verify:budgets": "node scripts/verify-budgets.mjs",
    "baseline:update": "node scripts/measure-baseline.mjs --update",
    "harness:seed": "node harness/fixtures/seed.mjs",
    "harness:seed:down": "node harness/fixtures/seed.mjs --down",
    "harness:verify": "node harness/fixtures/verify.mjs",
    "harness:unit": "vitest run --config harness/vitest.config.mts",
    "harness:unit:watch": "vitest --config harness/vitest.config.mts",
    "harness:all": "npm run harness:guard && npm run harness:unit",
    "harness:contract": "vitest run --config harness/contract/vitest.config.mts",
    "harness:e2e": "playwright test --config harness/e2e/playwright.config.ts",
    "harness:visual": "playwright test --config harness/visual/playwright.config.ts",
    "harness:visual:update": "playwright test --config harness/visual/playwright.config.ts --update-snapshots",
    "harness:mutation": "node harness/mutation/run.mjs",
    "harness:bench": "node harness/bench/sale-latency.mjs",
    "harness:bench:till": "playwright test --config harness/bench/playwright.config.ts"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@ericblade/quagga2": "^1.12.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "html2pdf.js": "^0.14.0",
    "jose": "^6.1.3",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.6",
    "shadcn": "3.8.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
