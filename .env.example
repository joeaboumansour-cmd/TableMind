# Copy to .env.local and fill in.
# Values come from Supabase → Project Settings → API.
# .env.local is gitignored; production values live in Vercel env settings.

# Supabase project URL — safe to expose to the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase "anon" public key — safe to expose to the client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase "service_role" key — bypasses Row Level Security.
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Signing secret for session tokens. Minimum 32 characters, random.
# Not yet wired up — see P0-1/P0-8 in docs/AUDIT-2026-08.md.
# src/lib/auth/jwt.ts currently falls back to a hardcoded default if this is unset.
JWT_SECRET=

# Signing secret for ADMIN sessions (the /admin console and /api/admin/activity).
# Minimum 32 characters, random. Unlike JWT_SECRET above there is NO fallback:
# if this is unset, admin login returns 500 and every gated admin route returns
# 401. That is deliberate — see src/lib/auth/adminSession.ts.
#   openssl rand -base64 48
ADMIN_JWT_SECRET=

# ---------------------------------------------------------------------------
# Windows 7 tills (Chrome 109) — the legacy deployment
# ---------------------------------------------------------------------------
# Chrome 109 is the last Chrome that exists for Windows 7/8.1, and it cannot
# parse oklch()/color-mix(). `npm run build:legacy` produces a second bundle
# with the colours downlevelled to sRGB; see src/lib/browserSupport.ts.
#
# Set this on the MODERN deployment ONLY, to the origin of the legacy one.
# BrowserGate uses it to redirect an oklch-incapable browser there, so a shop
# can bookmark either address and still land on a till that renders.
#
# LEAVING IT UNSET IS SILENT: the modern build keeps serving Windows 7 the
# oklch stylesheet, and the shop sees the black-and-white till the legacy
# build exists to fix. Nothing fails, nothing logs — it just looks broken.
# Leave it empty for local development and for the legacy deployment itself.
NEXT_PUBLIC_LEGACY_URL=

# Set to `legacy` ONLY on the legacy deployment. `npm run build:legacy` sets it
# for you; it switches on the CSS downlevel pass, the sub-109 upgrade page in
# middleware, and turns BrowserGate's redirect off so it cannot bounce forever.
NEXT_PUBLIC_BUILD_VARIANT=
