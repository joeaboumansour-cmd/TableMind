# Copy to .env.test. Points the characterization harness at a NON-PRODUCTION
# database. See P-1 in docs/PERF-REFACTOR-PLAN.md.
#
# .env.test is gitignored. This example file is not.
#
# ⚠️ The harness SEEDS AND MUTATES whatever database this names. It writes
# products, rings up sales, and opens and closes cash shifts. Never point it
# at the live project — `npm run harness:guard` exits 1 on the production
# hostname and cannot be talked out of it.

# Staging Supabase project URL. One of:
#   * a Supabase branch of the existing project
#   * a second Supabase project seeded from supabase/migrations/*
#   * local Docker (`supabase start`) — http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Staging anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Staging service_role key. SERVER/HARNESS ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# Admin session signing secret. Any random 32+ chars is fine for staging.
#   openssl rand -base64 48
ADMIN_JWT_SECRET=

# Optional: extra hostnames the harness must refuse, comma-separated.
# This can only ADD to the blocklist — it can never unblock production.
# HARNESS_BLOCKED_HOSTS=
