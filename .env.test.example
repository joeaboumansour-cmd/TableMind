# Copy to .env.test. Points the characterization harness at the database it
# is allowed to seed and mutate. See P-1 in docs/PERF-REFACTOR-PLAN.md.
#
# .env.test is gitignored. This example file is not.
#
# ⚠️ The harness SEEDS AND MUTATES whatever database this names. It writes
# products, rings up sales, and opens and closes cash shifts. None of it is
# recoverable. `npm run harness:guard` is the check; run it before anything.

# Supabase project URL. Either a dedicated non-production project, local
# Docker (`supabase start` — http://127.0.0.1:54321), or the main project
# under the confinement rules at the bottom of this file.
NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key. SERVER/HARNESS ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# Admin session signing secret. Any random 32+ chars will do here.
#   openssl rand -base64 48
ADMIN_JWT_SECRET=

# Optional: extra hostnames the harness must refuse, comma-separated.
# This can only ADD to the blocklist — it can never unblock the main project.
# HARNESS_BLOCKED_HOSTS=


# ---------------------------------------------------------------------------
# Running against the MAIN project
#
# Allowed by owner decision on 2026-08-30 — this deployment has no real
# clients (a survey found 5 stores and 118 transactions, i.e. demo volume).
#
# It requires BOTH keys below. They refuse two different mistakes, and either
# one alone still ends in a bad run:
#
#   HARNESS_ALLOW_PRODUCTION_HOST   "I know which database this is"
#   HARNESS_STORE_ID                "and the harness stays inside here"
#
# The second is doing the real work. Every table in this schema is
# store-scoped, so a dedicated store_id is the only thing standing between a
# seed run and the other stores' catalogues. The guard refuses an opt-in with
# no store id for exactly that reason.
#
# Create the tenant once; it is additive and touches nothing existing.
# ---------------------------------------------------------------------------

# HARNESS_ALLOW_PRODUCTION_HOST=yes

# A store_id the harness owns exclusively. Never a real store.
# HARNESS_STORE_ID=

# Login for that store. Plaintext, because that is how this app authenticates
# (AuthContext.tsx compares password_hash to the password directly — audit
# P0-4). Use a random value: it is a real credential on a shared host.
# HARNESS_STORE_USERNAME=
# HARNESS_STORE_PASSWORD=
